theme_override_font_sizes/font_size = 50
text = "Task 2: Move Samuel to the Living Room
Tip: Guide Samuel to the living room with patience.

Slow, Face-to-Face Instructions: Tell Samuel to go to the living room.
Repeat 3 Times: Repeat the instruction 3 times slowly, facing him directly.
Pause Between Instructions: Leave a 2-second gap between each instruction to give him time to process."
vertical_alignment = 1
autowrap_mode = 2

