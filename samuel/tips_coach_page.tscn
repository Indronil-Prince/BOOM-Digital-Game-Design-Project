theme_override_font_sizes/font_size = 40
text = "Task 6: Provide Samuel with Food from the Fridge
Tip: Use color-coded utensils to help Samuel recognize his food.

Color-Coded Plate: Samuel recognizes his food by the blue color-coded plate. Make sure his food is served on the blue plate so he knows it’s meant for him.
Avoid Mismatches: If the food isn’t on the correct plate, Samuel may not understand it’s for him."
vertical_alignment = 1
autowrap_mode = 2

